# --- Database ---
# Dev uses SQLite for zero-config local development.
# For production, swap the provider to "postgresql" in prisma/schema.prisma
# and point DATABASE_URL to your managed Postgres (e.g. Neon, RDS, Supabase).
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate a strong secret in production: `openssl rand -base64 32`
JWT_SECRET="dev-only-secret-change-me-in-production-please-32chars"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
